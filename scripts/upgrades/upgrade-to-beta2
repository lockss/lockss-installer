# Usage: upgrade-to-beta2 [-h|--help]
#
# Revision history:
# ---------------------------------------------------------------------------

PROGNAME=${0##*/}
VERSION="1.0"

#UPGRADE_FROM="2\.0(?:\.(\d))?-alpha6"
UPGRADE_TO="2.0.91-beta2"

## Relative paths
##

_0=$(basename "${0}")
_D0=$(dirname "${0}")

##
## Load _util
##

. "${_D0}/../_util"

COMPOSE_DIR="$(cd "${_D0}/../.." >/dev/null 2>&1 && pwd)"
CONFIG_DIR="${COMPOSE_DIR}/config"
SCRIPTS_DIR="${COMPOSE_DIR}/scripts"
LIB_DIR="${SCRIPTS_DIR}/lib"
UPDATES_DIR="${SCRIPTS_DIR}/upgrades"
DOCKER_CONFIGS_DIR="${CONFIG_DIR}/configs"
TEMPLATES_DIR="${CONFIG_DIR}/templates"
USEROPTS_DIR="${CONFIG_DIR}/useropts"

. "${_D0}/_util_upgrade"

##
## Definitions
##
declare -a arr svcs
declare -a arr lockss_owned
STACK_PREFIX="lockss-stack"
SYSTEM_CONF_FILE="${CONFIG_DIR}/system.cfg"
set -a
. "${SYSTEM_CONF_FILE}"
set +a

POSTGRES_VERSION_NEW='14.7-alpine'
POSTGRES_VERSION_OLD='9.6.12-alpine'
K3_VERSION_MIN='v1.31.5+k3s1'

clean_up() { # Perform pre-exit housekeeping
	return
}

error_exit() {
	echo -e "${PROGNAME}: ${1:-"Unknown Error"}" >&2
	clean_up
	exit 1
}

graceful_exit() {
	clean_up
	exit
}

signal_exit() { # Handle trapped signals
	case $1 in
		INT)
			error_exit "Program interrupted by user" ;;
		TERM)
			echo -e "\n$PROGNAME: Program terminated" >&2
			graceful_exit ;;
		*)
			error_exit "$PROGNAME: Terminating on unknown signal" ;;
	esac
}

usage() {
	echo -e "Usage: $PROGNAME [-h|--help] [--from <version>] [--to <version>]"
}

help_message() {
  cat <<- _EOF_
  $PROGNAME ver. $VERSION
  Update to beta2 from a previous alpha or beta release.

  $(usage)

  Options:
  -h, --help       Display this help message and exit.
  --from <version> Override the installed version (default: read from current VERSION file).
  --to <version>   Target version to upgrade to (default: ${UPGRADE_TO}).

_EOF_
  return
}

upgrade_postgres() {
  if ${USE_LOCKSS_POSTGRES}; then
    ${UPDATES_DIR}/upgrade-postgres --old-version ${POSTGRES_VERSION_OLD} --new-version ${POSTGRES_VERSION_NEW} ||
        err_exit "upgrade to postgres failed."
  else
    logger_info "Skipping postgres upgrade.  Only LOCKSS postgres upgrade is supported."
  fi
}

check_k3s_version() {
  set_k3s_bin_dir
  if command -v "${K3S_BIN_DIR}/k3s" > /dev/null && "${K3S_BIN_DIR}/k3s" kubectl version &> /dev/null ; then
    local cur_version="$("${K3S_BIN_DIR}/k3s" --version | awk '/^k3s version [^ ]+ \([0-9A-Fa-f]+\)$/{print $3;exit 0}{print;exit 1}')" \
            || error_exit "Error parsing K3s version"
    # Normalize version strings for comparison (convert +k3s to . for sort -V)
    local cur_version_normalized="$(Extract_K3s_Version "${cur_version}")"
    local min_version_normalized="$(Extract_K3s_Version "${K3_VERSION_MIN}")"
    if compare_versions_lt "${cur_version_normalized}" "${min_version_normalized}"; then
      err "$_0: K3s version ${cur_version} is too old. Please update your K3s installation to at least ${K3_VERSION_MIN}."
      err "$_0: Run scripts/install-lockss --install-k3s (as root), then"
      err "$_0:     scripts/install-lockss --test-k3s (as root)"
      err_exit "$_0: to upgrade your K3s installation, then rerun this script."
    fi
  else
    err_exit "$_0: Unable to find k3s executable. Make sure it has been installed and is on the path."
  fi
}

check_old_openwayback_directories() {
  local old_dirs=(
    "${LOCKSS_DATA_DIR}/lockss-stack-openwayback-data"
    "${LOCKSS_LOGS_DIR}/lockss-stack-openwayback-logs"
    "${LOCKSS_TMPDIR}/lockss-stack-openwayback-tmp"
  )
  # delete all old dirs if they exist.
  for dir in "${old_dirs[@]}"; do
    if [ -d "$dir" ]; then
      rm -rf "$dir"
    fi
  done
}

version_order() {
  case "$1" in
    2.0.*-alpha5) echo 1 ;;
    2.0.*-alpha6) echo 2 ;;
    2.0.*-alpha7) echo 3 ;;
    2.0.*-alpha8) echo 4 ;;
    2.0.*-beta1)  echo 5 ;;
    2.0.90-beta2)  echo 6 ;;
    2.0.91-beta2)  echo 7 ;;
    *) echo -1 ;;
  esac
}

reached_version() {
  local next_version="$1"
  local next_order
  next_order=$(version_order "$next_version")
  Set_Lockss_Version "${next_version}"
  if [ "$next_order" -ge "$TARGET_ORDER" ]; then
    logger_info "Upgrade completed, you must run scripts/configure-lockss -r"
    graceful_exit
  fi
}

###
## MAIN
###
# Trap signals
trap "signal_exit TERM" TERM HUP
trap "signal_exit INT"  INT
# Source system config file

if [ ! -r "$SYSTEM_CONF_FILE" ]; then
  err "$_0: The system configuration file does not exist.  This script requires the ./config/system.cfg file."
  err_exit "$_0: Run scripts/configure-lockss first."
fi

# Parse command-line
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      help_message; graceful_exit ;;
    --from)
      if [[ -z "${2:-}" ]]; then
        usage
        error_exit "--from requires a version argument"
      fi
      ARG_FROM="$2"
      shift 2
      ;;
    --to)
      if [[ -z "${2:-}" ]]; then
        usage
        error_exit "--to requires a version argument"
      fi
      ARG_TO="$2"
      shift 2
      ;;
    -* | --*)
      usage
      error_exit "Unknown option $1" ;;
    *)
      shift
      ;;
  esac
done

# Sanity checks
Check_Runnable
Check_Stopped
Check_Configured

if ! am_i_lockss; then
  error_exit "Please re-run the upgrade script as the ${LOCKSS_USER} user"
fi

logger_init

read_config ${SYSTEM_CONF_FILE}
logger_debug "Loaded LOCKSS system configuration"
VERSION_FILE="${LOCKSS_DATA_DIR}/VERSION"

# Resolve target version
TARGET_VERSION="${ARG_TO:-${UPGRADE_TO}}"
if Parse_Lockss_Version "${TARGET_VERSION}"; then
  TARGET_ORDER=$(version_order "${TARGET_VERSION}")
  if [[ "${TARGET_ORDER}" -lt "0" ]]; then
    error_exit "Unknown target version: ${TARGET_VERSION}"
  fi
else
  error_exit "Malformed target version: ${TARGET_VERSION}"
fi

# Resolve current (from) version
if [ -n "${ARG_FROM}" ]; then
  CUR_VERSION="${ARG_FROM}"
else
  if [ ! -f "${VERSION_FILE}" ]; then
    error_exit "Could not determine previous LOCKSS version (${VERSION_FILE} is missing)"
  fi
  CUR_VERSION="$(cat "${VERSION_FILE}")"
fi

if Parse_Lockss_Version "${CUR_VERSION}"; then
  FROM_ORDER=$(version_order "${CUR_VERSION}")
  if [[ "${FROM_ORDER}" -lt "0" ]]; then
    error_exit "Unknown current version: ${CUR_VERSION}"
  fi
else
  error_exit "Malformed current version: ${CUR_VERSION}"
fi

# Nothing to do if already at or past target
if [ "$FROM_ORDER" -ge "$TARGET_ORDER" ]; then
  logger_info "Nothing to upgrade (${CUR_VERSION} >= ${TARGET_VERSION})"
  graceful_exit
fi

case "${CUR_VERSION}" in
  2.0.*-alpha5)
    logger_info "Performing upgrade from 2.0-alpha5"

    # Repository Service changes
    rename_collections_dir
    rename_tempwarcs_dir
    remove_journal_files

    # Reset Solr for reindex
    reset_solr_index
    reset_index_state
    signal_reindex "${STACK_PREFIX}"

    reached_version "2.0.61-alpha6"
    ;&
  2.0.*-alpha6)
    logger_info "Performing upgrade from 2.0-alpha6"
    upgrade_postgres

    reached_version "2.0.72-alpha7"
    ;&
  2.0.*-alpha7)
    logger_info "Performing upgrade from 2.0-alpha7"

    reached_version "2.0.84-beta1"
    ;&
  2.0.*-beta1)
    logger_info "Performing upgrade from 2.0-beta1"
    # Update old port numbers in content_servers_config.txt
    update_content_servers_ports
    # Disable group writeable permission on log directories except postgres
    for _d in "${LOCKSS_LOGS_DIR}"/*-logs ; do
      if [[ -d "${_d}" && ! ${_d} =~ postgres ]]; then
        chmod 755 "${_d}"
      fi
    done
    # check for upgrade to k3s
    check_k3s_version
    logger_info "The next time LOCKSS is started it will create a new artifact index."
    logger_info "This may take substantial time if you have a lot of content."

    echo
    logger_info "NOTE: The ports used to access LOCKSS UI and REST services have changed."
    logger_info "See the Network Ports section of the LOCKSS ${MATCH_SHORT_VERSION} System Manual."
    echo
    reached_version "2.0.90-beta2"
    ;&
  2.0.90-beta2)
#    logger_info "Performing upgrade from 2.0.90-beta2"
    # Remove old Openwayback directories
    check_old_openwayback_directories
    logger_info "Removing Kubernetes Persistent Volume Claims and Persistent Volumes"
    # Remove Kubernetes Persistent Volume Claims and Persistent Volumes
    kubectl_lockss delete pvc --all
    kubectl_lockss delete pv --all
    reached_version "${UPGRADE_TO}"
    ;&
  2.0.91-beta2)
    logger_info "Already upgraded to 2.0.91-beta2"
    ;;
  *)
    error_exit "Do not know how to upgrade from ${CUR_VERSION}"
    ;;
esac
