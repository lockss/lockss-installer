# this doesn't work - tmpfiles has no value either here or immediately
# after a call to maketemp
tmpfiles=""
teardown() {
  for x in ${tmpfiles}; do
    rm -rf ${s}
  done
}

maketemp() {
  local t=$(mktemp "$@")
  tmpfiles="${tmpfiles} $t"
  echo $t
}

