apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: lockss-network-policy
  namespace: lockss
spec:
  podSelector:
    matchLabels:
      service-kind: non-lockss
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector: {}
    - from:
        - ipBlock:
            cidr: 10.255.0.0/16
      ports:
        - port: 24681
        - port: 24682
        - port: 8080
{{#LOCKSS_SUBNETS}}
    - from:
        - ipBlock:
            cidr: "{{.}}"
      ports:
        - port: 24681
        - port: 24682
        - port: 8080
{{/LOCKSS_SUBNETS}}